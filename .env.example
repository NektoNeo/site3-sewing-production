# Example Environment Variables
# Скопируйте этот файл в .env.local и заполните значения

# Sentry Configuration
# Получить DSN: https://sentry.io/settings/projects/
SENTRY_DSN="your-sentry-dsn-here"
NEXT_PUBLIC_SENTRY_DSN="your-sentry-dsn-here"

# Site URL
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"

# E2E Testing - Disable heavy animations/effects for faster tests
# Установить в "true" только для Playwright тестов
# NEXT_PUBLIC_DISABLE_ANIMATIONS="true"
